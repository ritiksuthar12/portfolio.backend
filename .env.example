# ==============================================================================
# Ritik Suthar - Backend Server Environment Configuration (Template)
# Copy this file to .env in the server directory
# ==============================================================================

# Backend Server Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Local: mongodb://127.0.0.1:27017/ritik_portfolio
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/ritik_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ritik_portfolio

# Secret key used for signing JWT tokens (Change to a long random secret in production)
JWT_SECRET=ritik_suthar_portfolio_secret_jwt_key_2026_super_secure

# Admin Credentials for Portfolio Management Portal
ADMIN_USERNAME=ritik
ADMIN_PASSWORD=admin123

# ImageKit Cloud Storage Configuration (Optional - MongoDB Atlas Buffer works out-of-the-box)
# Obtain free keys from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

